{
  "expo": {
    "name": "PDR Comercial",
    "slug": "pdr-comercial",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pdrcomercial",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cl.parquedelrecuerdo.comercial",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "package": "cl.parquedelrecuerdo.comercial",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E563A"
      },
      "predictiveBackGestureEnabled": false,
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E563A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9dc54597-4f92-4f8a-afb3-004f041def89"
      }
    },
    "owner": "nanoeslanchs-team",
    "updates": {
      "url": "https://u.expo.dev/9dc54597-4f92-4f8a-afb3-004f041def89"
    }
  }
}
